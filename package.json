{
  "name": "gym-lib",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "ios": "bun run build && cap sync ios && cap open ios",
    "ios:sync": "bun run build && cap sync ios",
    "ios:run": "bun run build && cap sync ios && cap run ios",
    "ios:archive": "bun run build && cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -destination 'generic/platform=iOS' -archivePath \"$HOME/Library/Developer/Xcode/Archives/$(date +%Y-%m-%d)/GymLib $(date +%H-%M-%S).xcarchive\" archive",
    "ios:export": "xcodebuild -exportArchive -archivePath build/ios/GymLib.xcarchive -exportOptionsPlist ios/ExportOptions.plist -exportPath build/ios/export",
    "ios:upload": "xcrun altool --upload-app -f build/ios/export/App.ipa -t ios --apiKey \"$ASC_KEY_ID\" --apiIssuer \"$ASC_ISSUER\"",
    "ios:release": "./scripts/release-testflight.sh",
    "training:example": "bun scripts/generate-training-program.ts",
    "training:audit": "bun scripts/audit-training-exercises.ts",
    "training:benchmark": "bun scripts/benchmark-training-engine.ts",
    "training:test": "vitest run src/training"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/react": "^0.5.0",
    "@flomentumsolutions/capacitor-health-extended": "^0.8.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@toolwind/corner-shape": "0.0.8-3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ios-haptics": "^3.1.1",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.11"
  }
}
